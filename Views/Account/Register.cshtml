<h2>สมัครสมาชิก</h2>
<form asp-action="Register" method="post">
    <input name="fullName" placeholder="ชื่อเต็ม" class="form-control" />
    <span class="text-danger mb-3">ชื่อห้ามซ้ำ</span>

    <input name="email" placeholder="อีเมล" class="form-control" />

    <input name="username" placeholder="ชื่อผู้ใช้" class="form-control" />
    <input name="password" type="password" placeholder="รหัสผ่าน" class="form-control" />
    <span class="text-danger mb-3">รหัสผ่านต้องมีตัวเลข ตัวอักษรพิมพ์ใหญ่และพิมพ์เล็กรวมถึงสัญลักษณ์พิเศษ</span>
    <br />
    <input name="phonenumber" placeholder="เบอร์โทรศัพท์" class="form-control" />
    <button type="submit" class="btn btn-primary mt-2">สมัคร</button>
    <br />
    <a asp-action="Login">Login</a>
</form>