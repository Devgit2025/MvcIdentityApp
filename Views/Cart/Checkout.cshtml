@model IEnumerable<CartItem>
@{
    ViewData["Title"] = "Checkout";
}
@{
    decimal total_price = 0; // 🔹 ประกาศตัวแปรก่อนเริ่ม foreach
    int i = 0;
}

<form asp-action="Calculator" asp-controller="Cart" method="post">
<table class="table table-bordered border-primary">
    <tr>
        <th>รายการสั่งซื้อ</th>
        <th>จำนวนชิ้น</th>
        <th>ราคารวม(บาท)</th>

    </tr>
        
        @foreach (var item in Model)
    {
        total_price += item.Cart_Total;  // 🔹 บวกค่าในฝั่ง C#
        i++;
            <tr>
            <td> - @item.Cart_Name
                <input  type="hidden" name="pro_id" value="@item.Cart_Id"/>
                <input type="hidden" name="pro_name" value="@item.Cart_Name" />
                <input type="hidden" name="pro_price" value="@item.Cart_Price" />
                <input type="hidden" name="quantity" value="@item.Cart_Quantity" />
                <input type="hidden" name="total" value="@item.Cart_Total" />



            </td>
            <td>@item.Cart_Quantity</td>
            <td>@item.Cart_Total</td>
        </tr>
        
    }

    <tr>
        <td colspan="3">
            <p>ชื่อลูกค้า : @ViewBag.Fullname</p>
            <p>อีเมล์ : @ViewBag.Email</p>
            <p>เบอร์โทรศัพท์ : @ViewBag.Phone</p>
            <p>ที่อยู่ : @ViewBag.Address</p>

        </td>
    </tr>
  
    <tr>
        <td colspan="3">
            <h5 style="margin-top:10px" class="text-end">
                <strong>ยอดรวมทั้งหมด:</strong>
                @Model.Sum(i => i.Cart_Total).ToString("N2") บาท
                
            </h5>
        </td>
    </tr>
    
</table>

    <div class="text-end">
        <input type="hidden" name="total_price" value="@total_price" />

        <button type="submit" class="btn btn-success mt-2">คิดเงิน </button>

    </div>
</form>


