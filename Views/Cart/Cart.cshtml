@model IEnumerable<CartItem>

@{
    ViewData["Title"] = "Cart";
}

<h1>Cart</h1>

<h2>🛒 ตะกร้าสินค้า</h2>

@if (!Model.Any())
{
    <p>ยังไม่มีสินค้าในตะกร้า</p>
}
else
{
    <table class="table table-striped table-hover">
        <tr>
            <th>สินค้า</th>
            <th>ราคา</th>
            <th>จำนวน</th>
            <th>รวม</th>
            <th></th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Cart_Name</td>
                <td>@item.Cart_Price.ToString("N2")</td>
                <td>@item.Cart_Quantity</td>
                <td>@item.Cart_Total.ToString("N2")</td>
                <td><a href="/Cart/RemoveItem/@item.Cart_Id" class="btn btn-danger" onclick="return confirm('คุณต้องการลบ @item.Cart_Name หรือไม่')">ลบ</a></td>
            </tr>
        }
    </table>

    <h5 style="margin-top:10px" class="text-end">
        <strong>ยอดรวมทั้งหมด:</strong>
        @Model.Sum(i => i.Cart_Total).ToString("N2") บาท
    </h5>
    
    <div class="text-end">
        <a href="/Cart/OrderBuy" class="btn btn-success mt-3">สั่งซื้อ</a>
        <a href="/Cart/ClearCart" class="btn btn-secondary mt-3">ยกเลิกออเดอร์</a>
        <a href="/Cart/Index" class="btn btn-outline-primary mt-3">⬅️ กลับไปเลือกสินค้า</a>

    </div>
}



