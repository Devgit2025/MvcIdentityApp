@model IEnumerable<Product>

@{
    ViewData["Title"] = "Index";
}

<h2>ยินดีต้อนรับ,@ViewBag.Username</h2>
<a class="btn btn-danger" asp-controller="Account" asp-action="Logout">ออกจากระบบ</a>
<br />

<h2>รายการสินค้า</h2>

<table border="1" cellpadding="8">
    <tr>
        <th>ชื่อสินค้า</th>
        <th>ราคา</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Pro_Name</td>
            <td>@item.Pro_Price.ToString("N2") บาท</td>
            <td>
                <a href="/Cart/AddToCart/@item.Pro_Id">เพิ่มลงตะกร้า</a>
            </td>
        </tr>
    }
</table>

<br />
<a href="/Cart/Cart">ไปหน้าตะกร้าสินค้า 🛒</a>

